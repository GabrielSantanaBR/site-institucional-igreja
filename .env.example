# E-mail da conta ChatGPT do proprietário do painel
SUPER_ADMIN_EMAIL=seu-email@example.com

# Gere 32 bytes aleatórios em base64. Nunca coloque a chave real no GitHub.
PRAYER_ENCRYPTION_KEY=

# Valor aleatório usado para anonimizar endereços IP no controle antispam.
IP_HASH_SALT=

# Destinatário temporário das notificações de novos pedidos de oração.
PRAYER_NOTIFICATION_EMAIL=intercessao@example.com

# Chave da API transacional Brevo. Configure como segredo na hospedagem.
BREVO_API_KEY=

# Remetente previamente verificado na conta Brevo.
BREVO_SENDER_EMAIL=remetente-verificado@example.com
