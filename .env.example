# E-mail da conta ChatGPT do proprietário do painel
SUPER_ADMIN_EMAIL=seu-email@example.com

# Gere 32 bytes aleatórios em base64. Nunca coloque a chave real no GitHub.
PRAYER_ENCRYPTION_KEY=

# Valor aleatório usado para anonimizar endereços IP no controle antispam.
IP_HASH_SALT=

# Destinatário temporário das notificações de novos pedidos de oração.
PRAYER_NOTIFICATION_EMAIL=intercessao@example.com

# Destinatário das novas mensagens gerais do Fale Conosco. Se vazio, usa o destinatário acima.
CONTACT_NOTIFICATION_EMAIL=secretaria@example.com

# Chave da API transacional Brevo. Configure como segredo na hospedagem.
BREVO_API_KEY=

# Remetente previamente verificado na conta Brevo.
BREVO_SENDER_EMAIL=remetente-verificado@example.com

# Credenciais do painel reservado. Configure os valores reais como segredos.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Chave aleatória exclusiva para assinar as sessões do painel.
ADMIN_SESSION_SECRET=

# Endereço canônico público. Hoje pode apontar para o workers.dev; quando a
# igreja tiver domínio próprio, use o endereço HTTPS dele e publique novamente.
PUBLIC_SITE_URL=https://pibrg-guadalupe.tudoido521.workers.dev
