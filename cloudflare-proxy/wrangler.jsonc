{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pibrg-guadalupe",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": [
      "BREVO_API_KEY",
      "BREVO_SENDER_EMAIL",
      "PRAYER_NOTIFICATION_EMAIL"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
